# Server configuration
PORT="3000"
JWT_SECRET="your_jwt_secret_key_here"

# PostgreSQL Database Configuration (optional: defaults to persistent embedded store if not connected)
DATABASE_URL="postgres://postgres:password123@localhost:5432/sweety_db"
PGHOST="localhost"
PGPORT="5432"
PGUSER="postgres"
PGPASSWORD="password123"
PGDATABASE="sweety_db"

# GEMINI_API_KEY: Required if AI smart glucose insights are enabled
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Host URL
APP_URL="http://localhost:3000"
